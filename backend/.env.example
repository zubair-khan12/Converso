# Copy to .env and fill in. Never commit the real .env.

# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Database (local postgresql@15)
DATABASE_URL=postgresql+psycopg2://omerbhatti@localhost:5432/voice_ai_platform

# Embeddings — dimension must match the document_chunks.embedding vector size
EMBEDDING_DIM=1536

# Fernet key for encrypting tenant integration credentials (e.g. Vapi API keys)
# at rest. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
