# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).
#
# Nothing sensitive has a working default in config.py — a default that works
# is a secret that has already leaked, since this repo is committed. Anything
# marked REQUIRED must be set, or the app refuses to start in production.

# development | production
# `production` enables HTTPS-only admin cookies and turns the checks below from
# warnings into a hard startup failure.
ENVIRONMENT=development

# --- Secrets -----------------------------------------------------------------

# REQUIRED. Signs the admin session cookie. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED. Encrypts tenant integration credentials (Vapi, Cal.com, Telnyx) at
# rest. Must be a urlsafe-base64 32-byte Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use a DIFFERENT key per environment. Rotating it makes existing encrypted
# credentials unreadable — tenants must reconnect their integrations.
ENCRYPTION_KEY=

# REQUIRED. Includes the password, which is why it has no default.
#   local:  postgresql+psycopg2://USER@localhost:5432/voice_ai_platform
#   Neon:   postgresql+psycopg2://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=

# REQUIRED for the knowledge base and Cal.com scheduling (embeddings +
# generation). Everything else runs without it.
OPENAI_API_KEY=

# NOTE: there is no VAPI_API_KEY / CALCOM_API_KEY / TWILIO_* here on purpose.
# Those are per-tenant, not platform-wide: each tenant pastes their own in the
# dashboard and it's stored encrypted in the `integrations` table. A shared
# platform key would put every tenant's calls on one account.

# --- Non-secret configuration ------------------------------------------------

# Must match the embedding model's output size AND the document_chunks.embedding
# vector column. text-embedding-3-small -> 1536.
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small
RAG_LLM_MODEL=gpt-4.1-nano

# Where Vapi's servers reach us for custom-LLM calls.
#   LOCAL DEV: set NGROK_URL to a tunnel — Vapi cannot reach localhost.
#   PRODUCTION: leave NGROK_URL empty, set PUBLIC_BACKEND_URL to the https origin.
NGROK_URL=
PUBLIC_BACKEND_URL=http://localhost:5000

# Browser origins allowed to call the API directly. In production set this to
# the real frontend origin only.
# CORS_ORIGINS=["https://app.yourdomain.com"]

# --- Self-signup -------------------------------------------------------------

# Master switch for public signup. false leaves the product admin-provisioned
# only — a way to close signups without a deploy if they're being abused.
SIGNUP_ENABLED=true

# Knowledge sources one tenant may hold. Signup is open and email is NOT
# verified, so anyone with a throwaway address can spend the platform
# OPENAI_API_KEY on embeddings; this is what bounds that. 0 disables the cap.
MAX_DOCUMENTS_PER_TENANT=25

# Where new-signup alerts go. Leave ADMIN_NOTIFY_EMAIL or SMTP_HOST empty and
# they're printed to the server console instead — signups are still recorded in
# the database either way, the email is only the nudge.
ADMIN_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
